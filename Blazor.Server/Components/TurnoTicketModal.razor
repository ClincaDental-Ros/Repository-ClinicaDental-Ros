@inject TurnoApiClient ApiClient

@if (Show && Turno != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15,23,42,.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow-lg">

                <!-- ENCABEZADO DEL COMPROBANTE -->
                <div class="modal-header-gradiente text-center position-relative pt-4 pb-5">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" @onclick="Cerrar"></button>
                    <div class="mx-auto mb-2 d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-success"
                         style="width: 60px; height: 60px;">
                        <i class="bi bi-check-lg fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-0">Comprobante de turno</h5>
                    <small class="text-white-50">Clínica Odontológica Turno Molar</small>
                </div>

                <!-- DATOS DEL TURNO -->
                <div class="modal-body px-4 pt-0">
                    <div class="panel p-3 text-center mb-3" style="margin-top: -28px;">
                        <div class="stat-titulo">Código de reserva</div>
                        <div class="fs-4 fw-bold texto-primary">TM-@Turno.Id.ToString("D5")</div>
                    </div>

                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary"><i class="bi bi-person me-1"></i>Paciente</span>
                            <span class="fw-bold">@Turno.PacienteNombre</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary"><i class="bi bi-person-badge me-1"></i>Profesional</span>
                            <span class="fw-bold">@Turno.OdontologoNombre</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary"><i class="bi bi-tag me-1"></i>Especialidad</span>
                            <span class="fw-bold">@Turno.EspecialidadNombre</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-secondary"><i class="bi bi-calendar-event me-1"></i>Fecha y hora</span>
                            <span class="fw-bold texto-primary">@Turno.Fecha.ToString("dd/MM/yyyy") a las @Turno.HorarioTurno</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-secondary"><i class="bi bi-info-circle me-1"></i>Estado</span>
                            <EstadoBadge Estado="@Turno.EstadoTurno" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center pb-4">
                    <button type="button" class="btn btn-theme-primary rounded-pill px-5" @onclick="Cerrar">
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public TurnoOdontologicoDTO? Turno { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private async Task Cerrar()
    {
        await OnClosed.InvokeAsync();
    }
}