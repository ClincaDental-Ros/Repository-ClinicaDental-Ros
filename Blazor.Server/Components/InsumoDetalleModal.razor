@inject InsumoApiClient ApiClient

@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">

                <!-- HEADER -->
                <div class="modal-header btn-theme-primary text-white">
                    <h5 class="modal-title fw-bold">
                        📦 @(IsEditing ? $"Editar Insumo #{Model.Id}" : "Registrar Insumo / Material")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body p-4">

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            @errorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold" style="color: var(--color-text-primary);">Nombre *:</label>
                        <input type="text" class="form-control" @bind="Model.Nombre" placeholder="Ej: Anestesia Tubano, Guantes Nitrilo..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" style="color: var(--color-text-primary);">Descripción:</label>
                        <textarea class="form-control" rows="2" @bind="Model.Descripcion" placeholder="Detalles o especificaciones técnicas del insumo..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="color: var(--color-text-primary);">Precio Unit. ($) *:</label>
                            <input type="text" class="form-control" @bind="precioTexto" placeholder="0.00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="color: var(--color-text-primary);">Stock Inicial *:</label>
                            <input type="text" class="form-control" @bind="stockTexto" placeholder="10" />
                        </div>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-theme-secondary" @onclick="Cerrar" disabled="@isSaving">Cancelar</button>
                    <button type="button" class="btn btn-theme-primary" @onclick="GuardarInsumo" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "💾 Guardar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public InsumoDTO Model { get; set; } = new();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isSaving = false;
    private string errorMessage = "";
    private string precioTexto = "0.00";
    private string stockTexto = "10";

    protected override void OnParametersSet()
    {
        if (Show)
        {
            errorMessage = "";
            precioTexto = Model.Precio.ToString("F2");
            stockTexto = Model.Stock.ToString();
        }
    }

    private async Task Cerrar()
    {
        await OnClosed.InvokeAsync();
    }

    private async Task GuardarInsumo()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(Model.Nombre))
        {
            errorMessage = "El nombre del insumo es obligatorio.";
            return;
        }

        if (!decimal.TryParse(precioTexto.Trim(), out var precio) || precio < 0)
        {
            errorMessage = "El precio debe ser un número válido mayor o igual a 0.";
            return;
        }

        if (!int.TryParse(stockTexto.Trim(), out var stock) || stock < 0)
        {
            errorMessage = "El stock debe ser un número entero no negativo.";
            return;
        }

        Model.Precio = precio;
        Model.Stock = stock;
        isSaving = true;

        try
        {
            if (!IsEditing)
            {
                await ApiClient.CreateAsync(Model);
            }
            else
            {
                await ApiClient.UpdateAsync(Model);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}