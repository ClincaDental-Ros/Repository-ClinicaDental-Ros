@* Confirmación de cierre de sesión. *@
@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15,23,42,.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header-gradiente text-center py-4">
                    <div class="mx-auto mb-2 d-inline-flex align-items-center justify-content-center rounded-circle"
                         style="width: 64px; height: 64px; background: rgba(255,255,255,.15);">
                        <i class="bi bi-box-arrow-right fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-0 text-white">¿Querés cerrar sesión?</h5>
                </div>
                <div class="modal-body text-center text-secondary px-4">
                    Vas a salir de Turno Molar. Para volver a entrar tenés que iniciar sesión de nuevo.
                </div>
                <div class="d-flex gap-2 justify-content-center pb-4">
                    <button type="button" class="btn btn-theme-secondary rounded-pill px-4" @onclick="() => OnResponse.InvokeAsync(false)">Cancelar</button>
                    <button type="button" class="btn btn-theme-danger rounded-pill px-4" @onclick="() => OnResponse.InvokeAsync(true)">Sí, cerrar sesión</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    /// <summary>true si el usuario confirma.</summary>
    [Parameter] public EventCallback<bool> OnResponse { get; set; }
}
