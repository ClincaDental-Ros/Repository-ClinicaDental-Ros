@page "/insumos"
@attribute [Authorize(Roles = Permisos.Insumos)]
@inject InsumoApiClient ApiClient

<PageTitle>Insumos y Stock - Turno Molar</PageTitle>

<div class="container-fluid p-0">

    <PageHeader Titulo="Control de Insumos, Materiales y Stock Clínico" Subtitulo="Inventario odontológico, costos unitarios y control de stock crítico" Icono="bi-box-seam" />

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Insumos Registrados" Detalle="Materiales distintos" Color="primary" Icono="bi-box-seam">@insumos.Count</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Stock Total" Detalle="Unidades físicas" Color="success" Icono="bi-boxes">@insumos.Sum(i => i.Stock) u.</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Stock Crítico" Detalle="Menor o igual a 10 u." Color="@(CriticosCount > 0 ? "danger" : "secondary")" Icono="bi-exclamation-triangle">@CriticosCount ítems</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Valorizado" Detalle="Valor en almacén" Color="info" Icono="bi-currency-dollar">@ValorInventario.ToString("C0")</StatCard>
        </div>
    </div>

    <div class="bg-white p-3 border-top border-bottom">
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-theme-success" @onclick="AbrirModalNuevo">
                + Nuevo Insumo
            </button>
            <button class="btn btn-theme-secondary" @onclick="ModificarSeleccionado" disabled="@(seleccionado == null)">
                <i class="bi bi-pencil-square"></i> Modificar
            </button>
            <button class="btn btn-theme-danger" @onclick="SolicitarEliminar" disabled="@(seleccionado == null)">
                <i class="bi bi-trash"></i> Eliminar
            </button>
        </div>
    </div>

    <div>
        <div class="table-responsive panel">
            <table class="table table-hover align-middle mb-0 table-theme">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th style="width: 260px;">Insumo / Material</th>
                        <th>Descripción</th>
                        <th style="width: 160px;">Precio Unitario ($)</th>
                        <th style="width: 160px;">Stock Disponible</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <div class="small text-muted mt-2">Cargando inventario...</div>
                            </td>
                        </tr>
                    }
                    else if (insumos.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No hay insumos o materiales registrados en el sistema.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in insumos)
                        {
                            <tr class="@(seleccionado?.Id == item.Id ? "selected-row" : "")"
                                @onclick="() => seleccionado = item"
                                @ondblclick="() => AbrirModalEditar(item)"
                                style="cursor: pointer;">
                                <td><strong>#@item.Id</strong></td>
                                <td><span class="fw-bold">@item.Nombre</span></td>
                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "-" : item.Descripcion)</td>
                                <td><strong>@item.Precio.ToString("C2")</strong></td>
                                <td>
                                    @if (item.Stock <= 10)
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold border border-danger">
                                            @item.Stock u. <i class="bi bi-exclamation-triangle"></i> (Crítico)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success fw-bold border border-success">
                                            @item.Stock u.
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-white p-2 mt-2 border rounded text-muted small">
            @lblEstado
        </div>
    </div>
</div>

<!-- SUBCOMPONENTE MODAL DE EDICIÓN / ALTA -->
<InsumoDetalleModal Show="showModal"
                    Model="modalModel"
                    IsEditing="isEditing"
                    OnClosed="() => showModal = false"
                    OnSaved="HandleInsumoGuardado" />

<!-- MODAL DE CONFIRMACIÓN  -->
<ConfirmModal Show="showConfirmModal"
              Titulo="Confirmar Eliminación"
              Mensaje="@mensajeConfirmacion"
              OnResponse="HandleConfirmacionEliminar" />

@code {
    private List<InsumoDTO> insumos = new();
    private InsumoDTO? seleccionado;
    private string lblEstado = "Cargando inventario...";
    private bool isLoading = false;

    // Control del Modal
    private bool showModal = false;
    private bool isEditing = false;
    private InsumoDTO modalModel = new();

    // Control del Modal de Confirmación
    private bool showConfirmModal = false;
    private string mensajeConfirmacion = "";

    private int CriticosCount => insumos.Count(i => i.Stock <= 10);
    private decimal ValorInventario => insumos.Sum(i => i.Precio * i.Stock);

    protected override async Task OnInitializedAsync()
    {
        await CargarInsumos();
    }

    private async Task CargarInsumos()
    {
        isLoading = true;
        lblEstado = "Cargando inventario desde la API...";
        try
        {
            insumos = await ApiClient.GetAllAsync();
            lblEstado = $"Inventario: {insumos.Count} tipo(s) de insumos. Stock crítico: {CriticosCount}.";

            if (seleccionado != null)
            {
                seleccionado = insumos.FirstOrDefault(i => i.Id == seleccionado.Id);
            }
        }
        catch (Exception ex)
        {
            lblEstado = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AbrirModalNuevo()
    {
        modalModel = new InsumoDTO { Precio = 0m, Stock = 10 };
        isEditing = false;
        showModal = true;
    }

    private void AbrirModalEditar(InsumoDTO dto)
    {
        modalModel = new InsumoDTO
        {
            Id = dto.Id,
            Nombre = dto.Nombre,
            Descripcion = dto.Descripcion,
            Precio = dto.Precio,
            Stock = dto.Stock
        };
        isEditing = true;
        showModal = true;
    }

    private void ModificarSeleccionado()
    {
        if (seleccionado != null) AbrirModalEditar(seleccionado);
    }

    private async Task HandleInsumoGuardado()
    {
        showModal = false;
        await CargarInsumos();
    }

    private void SolicitarEliminar()
    {
        if (seleccionado == null) return;

        mensajeConfirmacion = $"¿Está seguro de eliminar el insumo '{seleccionado.Nombre}' del catálogo?";
        showConfirmModal = true;
    }

    private async Task HandleConfirmacionEliminar(bool confirmado)
    {
        showConfirmModal = false;

        if (confirmado && seleccionado != null)
        {
            try
            {
                await ApiClient.DeleteAsync(seleccionado.Id);
                seleccionado = null;
                await CargarInsumos();
            }
            catch (HttpRequestException ex)
            {
                // Por ejemplo, si otros datos todavía lo usan: se informa y la pantalla sigue funcionando.
                lblEstado = $"No se pudo eliminar el insumo: {ex.Message}";
            }
        }
    }
}
