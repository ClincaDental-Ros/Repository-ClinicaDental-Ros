@page "/turnos"
@attribute [Authorize(Roles = Permisos.Turnos)]
@inject TurnoApiClient ApiClient
@inject OdontologoApiClient OdontologoClient

<PageTitle>Gestión de Turnos - Turno Molar</PageTitle>

<div class="container-fluid p-0">

    <PageHeader Titulo="Gestión de Turnos y Agenda Odontológica" Subtitulo="Monitoreo de citas, estados de atención, cancelaciones y sala de espera" Icono="bi-calendar2-week" />

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Total Turnos" Detalle="En el período" Color="primary" Icono="bi-calendar2-week">@turnos.Count</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Citados" Detalle="Por asistir" Color="warning" Icono="bi-hourglass">@turnos.Count(t => t.EstadoTurno == "Pendiente")</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="En Espera" Detalle="Llegaron a clínica" Color="info" Icono="bi-hourglass-split">@turnos.Count(t => t.EstadoTurno == "Presente")</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Atendidos" Detalle="Consultas realizadas" Color="success" Icono="bi-check2-circle">@turnos.Count(t => t.EstadoTurno == "Atendido")</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Inasistencias" Detalle="Multados" Color="danger" Icono="bi-person-x">@turnos.Count(t => t.EstadoTurno == "NoAsistido")</StatCard>
        </div>
    </div>

    <div class="bg-white p-3 border-top border-bottom">
        <div class="row g-2 align-items-center">
            <div class="col-md-4 col-xxl-3 d-flex align-items-center gap-2">
                <div class="form-check me-1">
                    <input class="form-check-input" type="checkbox" id="chkFiltrarFecha"
                           @bind="usarFiltroFecha" @bind:after="CargarTurnos" />
                    <label class="form-check-label fw-bold text-secondary" for="chkFiltrarFecha">Fecha:</label>
                </div>
                <input type="date" class="form-control" disabled="@(!usarFiltroFecha)"
                       @bind="filtroFecha" @bind:after="CargarTurnos" />
            </div>

            <div class="col-md-4 col-xxl-3">
                <div class="input-group">
                    <span class="input-group-text bg-light fw-bold text-secondary">Estado:</span>
                    <select class="form-select" @bind="filtroEstado" @bind:after="CargarTurnos">
                        <option value="Todos">Todos los estados</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Presente">Presente</option>
                        <option value="Atendido">Atendido</option>
                        <option value="Cancelado">Cancelado</option>
                        <option value="NoAsistido">NoAsistido</option>
                    </select>
                </div>
            </div>

            <div class="col-md-4 col-xxl-3">
                <div class="input-group">
                    <span class="input-group-text bg-light fw-bold text-secondary">Odontólogo:</span>
                    <select class="form-select" @bind="filtroOdontologoId" @bind:after="CargarTurnos">
                        <option value="0">Todos los profesionales</option>
                        @foreach (var o in filtroOdontologos)
                        {
                            <option value="@o.Id">@o.NombreCompleto</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-12 col-xxl-3 d-flex justify-content-end gap-2 flex-wrap">
                <button class="btn btn-theme-primary" @onclick="CargarTurnos" disabled="@isLoading">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <button class="btn btn-theme-success" @onclick="() => showReservaModal = true">
                    <i class="bi bi-calendar-event"></i> Agendar Turno
                </button>
                <button class="btn btn-theme-danger" @onclick="SolicitarCancelarTurno" disabled="@(seleccionado == null)">
                    <i class="bi bi-x-circle"></i> Cancelar Turno
                </button>
            </div>
        </div>
    </div>

    <div>
        <div class="table-responsive panel">
            <table class="table table-hover align-middle mb-0 table-theme">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Fecha Cita</th>
                        <th>Horario</th>
                        <th>Paciente</th>
                        <th>Odontólogo Asignado</th>
                        <th>Especialidad</th>
                        <th>Estado</th>
                        <th>Observación / Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <div class="small text-muted mt-2">Cargando agenda de turnos...</div>
                            </td>
                        </tr>
                    }
                    else if (turnos.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se encontraron turnos registrados para los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in turnos)
                        {
                            <tr class="@(seleccionado?.Id == t.Id ? "selected-row" : "")"
                                @onclick="() => seleccionado = t"
                                style="cursor: pointer;">
                                <td><strong>#@t.Id</strong></td>
                                <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@t.HorarioTurno</span></td>
                                <td>@t.PacienteNombre</td>
                                <td>@t.OdontologoNombre</td>
                                <td>@t.EspecialidadNombre</td>
                                <td>
                                    <EstadoBadge Estado="@t.EstadoTurno" />
                                </td>
                                <td><small class="text-muted">@(t.MotivoCancelacion ?? "-")</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-white p-2 mt-2 border rounded text-muted small">
            @lblEstado
        </div>
    </div>
</div>

<!-- MODAL RESERVA DE TURNO -->
<TurnoReservaModal Show="showReservaModal"
                   OnClosed="() => showReservaModal = false"
                   OnReserved="HandleTurnoReservado" />

<!-- MODAL COMPROBANTE TICKET DIGITAL -->
<TurnoTicketModal Show="showTicketModal"
                  Turno="turnoCreadoTicket"
                  OnClosed="() => showTicketModal = false" />

<!-- MODAL DE CONFIRMACIÓN DE CANCELACIÓN -->
<ConfirmModal Show="showConfirmModal"
              Titulo="Cancelar Turno"
              Mensaje="@mensajeConfirmacion"
              OnResponse="HandleConfirmacionCancelar" />

<!-- MODAL ALERTA DE ADVERTENCIA -->
@if (showAlertModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle"></i> Atención</h5>
                    <button type="button" class="btn-close" @onclick="() => showAlertModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0 text-secondary">@alertMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-theme-secondary" @onclick="() => showAlertModal = false">Entendido</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TurnoOdontologicoDTO> turnos = new();
    private List<OdontologoDTO> filtroOdontologos = new();
    private TurnoOdontologicoDTO? seleccionado;

    private bool usarFiltroFecha = false;
    private DateTime filtroFecha = DateTime.Today;
    private string filtroEstado = "Todos";
    private int filtroOdontologoId = 0;

    private string lblEstado = "Cargando turnos...";
    private bool isLoading = false;

    // Modales
    private bool showReservaModal = false;
    private bool showTicketModal = false;
    private TurnoOdontologicoDTO? turnoCreadoTicket;

    private bool showConfirmModal = false;
    private string mensajeConfirmacion = "";

    private bool showAlertModal = false;
    private string alertMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarFiltroOdontologos();
        await CargarTurnos();
    }

    private async Task CargarFiltroOdontologos()
    {
        try
        {
            filtroOdontologos = await OdontologoClient.GetAllAsync();
        }
        catch (Exception ex)
        {
            alertMessage = $"No se pudo cargar el filtro de profesionales: {ex.Message}";
            showAlertModal = true;
        }
    }

    private async Task CargarTurnos()
    {
        isLoading = true;
        lblEstado = "Cargando turnos...";

        try
        {
            var criteria = new TurnoCriteriaDTO();

            if (usarFiltroFecha)
                criteria.Fecha = filtroFecha.Date;

            if (filtroEstado != "Todos")
                criteria.EstadoTurno = filtroEstado;

            if (filtroOdontologoId > 0)
                criteria.OdontologoId = filtroOdontologoId;

            turnos = await ApiClient.GetByCriteriaAsync(criteria);
            lblEstado = $"Agenda cargada: {turnos.Count} turno(s) en listado.";

            if (seleccionado != null)
            {
                seleccionado = turnos.FirstOrDefault(t => t.Id == seleccionado.Id);
            }
        }
        catch (Exception ex)
        {
            lblEstado = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleTurnoReservado(TurnoOdontologicoDTO creado)
    {
        showReservaModal = false;
        turnoCreadoTicket = creado;
        showTicketModal = true;
        await CargarTurnos();
    }

    private void SolicitarCancelarTurno()
    {
        if (seleccionado == null) return;

        if (seleccionado.EstadoTurno == "Cancelado" || seleccionado.EstadoTurno == "Atendido")
        {
            alertMessage = $"No se puede cancelar un turno en estado {seleccionado.EstadoTurno}.";
            showAlertModal = true;
            return;
        }

        mensajeConfirmacion = $"¿Desea cancelar el turno de {seleccionado.PacienteNombre} para el {seleccionado.Fecha:dd/MM/yyyy} a las {seleccionado.HorarioTurno}?";
        showConfirmModal = true;
    }

    private async Task HandleConfirmacionCancelar(bool confirmado)
    {
        showConfirmModal = false;

        if (confirmado && seleccionado != null)
        {
            await ApiClient.CancelarAsync(seleccionado.Id, "Cancelación solicitada por el usuario");
            seleccionado = null;
            await CargarTurnos();
        }
    }
}