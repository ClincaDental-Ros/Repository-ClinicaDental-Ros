@page "/portal-paciente"
@attribute [Authorize(Roles = Permisos.PortalPaciente)]
@inject BlazorServerAuthService AuthService
@inject TurnoApiClient TurnoClient
@inject ReportesApiClient ReportesClient
@inject MultaApiClient MultaClient
@inject PacienteApiClient PacienteClient

<PageTitle>Portal del Paciente - Turno Molar</PageTitle>

<div class="container-fluid p-0">

    <PageHeader Titulo="Portal del Paciente" Subtitulo="Tus turnos, tu historial clínico, tus pagos y tu cobertura" Icono="bi-house-heart" />

    <ul class="nav nav-pills gap-2 mb-3 flex-wrap">
        @foreach (var (indice, icono, texto) in pestanias)
        {
            <li class="nav-item">
                <a class="nav-link rounded-pill fw-semibold @(activeTab == indice ? "active" : "bg-white border text-secondary")" href="/portal-paciente?tab=@indice">
                    <i class="bi @icono me-1"></i>@texto
                </a>
            </li>
        }
    </ul>

    <div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small">@errorMessage</div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="small text-muted mt-2">Cargando tu portal...</div>
            </div>
        }
        else if (activeTab == 0)
        {
            <div class="hero mb-4">
                <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-1 small mb-2">Paciente</span>
                <h3 class="mb-1">¡Hola, @(AuthService.GetNombreCompleto() ?? "Paciente")!</h3>
                <p class="mb-0 text-white-50">Bienvenido/a a tu portal de salud dental.</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-lg-8">
                    <div class="panel p-4 h-100">
                        <div class="stat-titulo mb-3">Próximo turno</div>
                        @if (proximoTurno != null)
                        {
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="text-center rounded-4 tono-primary px-3 py-2" style="min-width: 76px;">
                                    <div class="fs-3 fw-bold lh-1">@proximoTurno.Fecha.Day</div>
                                    <div class="small fw-semibold text-uppercase">@proximoTurno.Fecha.ToString("MMM", new System.Globalization.CultureInfo("es-AR"))</div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold fs-5">@proximoTurno.EspecialidadNombre</div>
                                    <div class="text-secondary"><i class="bi bi-person-badge me-1"></i>@proximoTurno.OdontologoNombre</div>
                                    <div class="text-secondary"><i class="bi bi-clock me-1"></i>@proximoTurno.Fecha.ToString("dd/MM/yyyy") a las @proximoTurno.HorarioTurno hs</div>
                                    <div class="mt-2"><EstadoBadge Estado="@proximoTurno.EstadoTurno" /></div>
                                </div>
                                <button class="btn btn-theme-secondary" @onclick="VerTicket"><i class="bi bi-receipt me-1"></i>Ver comprobante</button>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-secondary py-3">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                                No tenés turnos próximos agendados.
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="panel p-4 h-100 d-flex flex-column justify-content-center text-center">
                        <span class="stat-icon tono-success mx-auto mb-2"><i class="bi bi-calendar-plus"></i></span>
                        <div class="fw-bold mb-1">¿Necesitás un turno?</div>
                        <p class="small text-secondary">Elegí especialidad, profesional y horario.</p>
                        <button class="btn btn-theme-primary" @onclick="() => showReservaModal = true">
                            <i class="bi bi-plus-lg me-1"></i>Solicitar turno
                        </button>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-secondary text-uppercase small mb-3">Nuestras especialidades</h6>
            <div class="row g-3">
                @foreach (var (icono, nombre) in especialidades)
                {
                    <div class="col-6 col-md-3">
                        <div class="panel p-3 text-center h-100">
                            <span class="stat-icon tono-primary mx-auto mb-2"><i class="bi @icono"></i></span>
                            <div class="fw-semibold">@nombre</div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == 1)
        {
            <div class="bg-white p-3 border rounded mb-3 d-flex gap-2 flex-wrap">
                <button class="btn btn-theme-success" @onclick="() => showReservaModal = true"><i class="bi bi-calendar-event"></i> Agendar Turno</button>
                <button class="btn btn-theme-danger" @onclick="SolicitarCancelarTurno" disabled="@(seleccionado == null)"><i class="bi bi-x-circle"></i> Cancelar Turno</button>
                <button class="btn btn-theme-secondary" @onclick="CargarDatos"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
            </div>

            <div class="table-responsive panel">
                <table class="table table-hover align-middle mb-0 table-theme">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Horario</th>
                            <th>Profesional Odontólogo</th>
                            <th>Especialidad</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (misTurnos.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Todavía no tenés turnos registrados.</td></tr>
                        }
                        else
                        {
                            @foreach (var t in misTurnos)
                            {
                                <tr class="@(seleccionado?.Id == t.Id ? "selected-row" : "")"
                                    @onclick="() => seleccionado = t"
                                    style="cursor: pointer;">
                                    <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@t.HorarioTurno</span></td>
                                    <td>@t.OdontologoNombre</td>
                                    <td>@t.EspecialidadNombre</td>
                                    <td><EstadoBadge Estado="@t.EstadoTurno" /></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (activeTab == 2)
        {
            // TAB HISTORIAL CLÍNICO
            if (historiaSinPermiso)
            {
                <div class="alert alert-warning">Tu historia clínica no está disponible en este momento. Consultá en Recepción.</div>
            }
            else if (historia == null)
            {
                <div class="alert alert-info">Todavía no tenés historia clínica registrada.</div>
            }
            else
            {
                <div class="bg-white p-3 border rounded mb-3">
                    <div class="fw-bold"><i class="bi bi-file-earmark-medical text-primary me-1"></i>Historia Clínica N° @historia.NumeroHistoriaClinica.ToString("D5") - @historia.PacienteNombre</div>
                    <div class="small text-muted mt-1">
                        • Antecedentes: @(string.IsNullOrWhiteSpace(historia.AntecedentesMedicos) ? "Sin datos" : historia.AntecedentesMedicos)
                        | Alergias: @(string.IsNullOrWhiteSpace(historia.Alergias) ? "Ninguna registrada" : historia.Alergias)
                    </div>
                </div>

                <div class="table-responsive panel">
                    <table class="table table-hover align-middle mb-0 table-theme">
                        <thead>
                            <tr>
                                <th>Fecha de Atención</th>
                                <th>Odontólogo</th>
                                <th>Diagnóstico (CIE-10)</th>
                                <th>Tratamiento Realizado</th>
                                <th>Observaciones Médicas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (historia.ConsultasPrevias.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">Todavía no tenés consultas registradas.</td></tr>
                            }
                            else
                            {
                                @foreach (var c in historia.ConsultasPrevias.OrderByDescending(c => c.Fecha))
                                {
                                    <tr>
                                        <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@c.OdontologoNombre</td>
                                        <td>@c.Diagnostico</td>
                                        <td>@c.Tratamiento</td>
                                        <td><small class="text-muted">@c.Observaciones</small></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (activeTab == 3)
        {
            <!-- TAB PAGOS Y SALDO -->
            <div class="panel p-4 mb-3 d-flex align-items-center gap-3 flex-wrap" style="max-width: 760px;">
                <span class="stat-icon @(DeudaTotal > 0 ? "tono-danger" : "tono-success")"><i class="bi @(DeudaTotal > 0 ? "bi-exclamation-octagon" : "bi-check2-circle")"></i></span>
                <div class="flex-grow-1">
                    <div class="stat-titulo">Saldo pendiente</div>
                    <div class="stat-valor @(DeudaTotal > 0 ? "texto-danger" : "texto-success")">@(DeudaTotal > 0 ? DeudaTotal.ToString("C2") : "$ 0,00")</div>
                    @if (DeudaTotal > 0)
                    {
                        <div class="small fw-semibold texto-danger">Tenés multas impagas: no podés reservar turnos nuevos hasta pagarlas.</div>
                    }
                    else
                    {
                        <div class="small fw-semibold texto-success">Estás al día y podés reservar turnos.</div>
                    }
                </div>
            </div>

            <h6 class="fw-bold">Detalle de Multas por Inasistencia o Cargos Pendientes:</h6>
            <div class="table-responsive panel" style="max-width: 760px;">
                <table class="table align-middle mb-0 table-theme">
                    <thead>
                        <tr>
                            <th>ID Multa</th>
                            <th>Monto ($)</th>
                            <th>Concepto / Motivo</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (misMultas.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">No tenés multas ni cargos pendientes.</td></tr>
                        }
                        else
                        {
                            @foreach (var m in misMultas)
                            {
                                <tr>
                                    <td>#@m.Id</td>
                                    <td>@m.Monto.ToString("C2")</td>
                                    <td>@m.Motivo</td>
                                    <td>
                                        @if (m.EstadoPago)
                                        {
                                            <span class="estado-badge estado-atendido">Pagada</span>
                                        }
                                        else
                                        {
                                            <span class="estado-badge estado-ausente">Impaga</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!m.EstadoPago)
                                        {
                                            <button class="btn btn-sm btn-theme-success" @onclick="() => SolicitarPago(m)"><i class="bi bi-credit-card"></i> Pagar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- TAB OBRA SOCIAL -->
            <div style="max-width: 460px;">
                <div class="hero mb-3" style="border-radius: 20px;">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <span class="small fw-bold text-white-50 text-uppercase">Credencial</span>
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <div class="fs-4 fw-bold">@(string.IsNullOrWhiteSpace(pacienteInfo?.ObraSocialNombre) ? "Particular" : pacienteInfo!.ObraSocialNombre)</div>
                    <div class="text-white-50 mb-3">@(string.IsNullOrWhiteSpace(pacienteInfo?.ObraSocialNombre) ? "Sin obra social registrada" : "N° de afiliado: " + (pacienteInfo!.NumeroAfiliado ?? "S/D"))</div>
                    <div class="fw-semibold">@(AuthService.GetNombreCompleto() ?? "Paciente")</div>
                </div>
                <p class="small text-muted mb-0"><i class="bi bi-info-circle me-1"></i>Para actualizar tu obra social o presentar una nueva credencial, acercate a Recepción.</p>
            </div>
        }
    </div>
</div>

<!-- MODALES (los mismos componentes que usa Turnos.razor) -->
<TurnoReservaModal Show="showReservaModal"
                   PacienteFijoId="pacienteId"
                   OnClosed="() => showReservaModal = false"
                   OnReserved="HandleTurnoReservado" />

<TurnoTicketModal Show="showTicketModal"
                  Turno="turnoTicket"
                  OnClosed="() => showTicketModal = false" />

<ConfirmModal Show="showConfirmModal"
              Titulo="Cancelar Turno"
              Mensaje="@mensajeConfirmacion"
              OnResponse="HandleConfirmacionCancelar" />

<ConfirmModal Show="showConfirmPago"
              Titulo="Pagar Multa"
              Mensaje="@mensajePago"
              OnResponse="HandleConfirmacionPago" />

@code {
    // Permite que el NavMenu abra una pestaña con /portal-paciente?tab=1
    [SupplyParameterFromQuery(Name = "tab")]
    public int? Tab { get; set; }

    private int activeTab = 0;
    private int? pacienteId;
    private bool isLoading = true;
    private string? errorMessage;

    private List<TurnoOdontologicoDTO> misTurnos = new();
    private TurnoOdontologicoDTO? proximoTurno;
    private TurnoOdontologicoDTO? seleccionado;
    private TurnoOdontologicoDTO? turnoTicket;

    private HistoriaClinicaDTO? historia;
    private bool historiaSinPermiso = false;
    private PacienteDTO? pacienteInfo;
    private List<MultaDTO> misMultas = new();
    private MultaDTO? multaAPagar;
    private bool showConfirmPago = false;
    private string mensajePago = "";

    private decimal DeudaTotal => misMultas.Where(m => !m.EstadoPago).Sum(m => m.Monto);

    private bool showReservaModal = false;
    private bool showTicketModal = false;
    private bool showConfirmModal = false;
    private string mensajeConfirmacion = "";

    private readonly (string Icono, string Nombre)[] especialidades =
    {
        ("bi-heart-pulse", "Odontología general"),
        ("bi-emoji-smile", "Ortodoncia"),
        ("bi-search", "Endodoncia"),
        ("bi-tools", "Implantología")
    };

    private readonly (int Indice, string Icono, string Texto)[] pestanias =
    {
        (0, "bi-house-door", "Inicio"),
        (1, "bi-calendar-check", "Mis turnos"),
        (2, "bi-file-earmark-medical", "Mi historial clínico"),
        (3, "bi-wallet2", "Pagos y deudas"),
        (4, "bi-shield-check", "Mi obra social")
    };

    protected override void OnParametersSet()
    {
        activeTab = Tab is >= 0 and <= 4 ? Tab.Value : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        pacienteId = AuthService.GetEntidadId();

        if (pacienteId == null)
        {
            errorMessage = "No se pudo identificar al paciente de esta sesión.";
            isLoading = false;
            return;
        }

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        errorMessage = null;
        var errores = new List<string>();

        // Turnos
        try
        {
            misTurnos = await TurnoClient.GetByCriteriaAsync(new TurnoCriteriaDTO { PacienteId = pacienteId });
        
            proximoTurno = misTurnos
                .Where(t => t.Fecha.Date >= DateTime.Today
                            && (t.EstadoTurno == "Pendiente" || t.EstadoTurno == "Presente"))
                .OrderBy(t => t.Fecha)
                .ThenBy(t => t.HorarioTurno)
                .FirstOrDefault();

            if (seleccionado != null)
                seleccionado = misTurnos.FirstOrDefault(t => t.Id == seleccionado.Id);
        }
        catch (Exception ex) { errores.Add($"turnos ({ex.Message})"); }

        // Datos del paciente (obra social)
        try
        {
            pacienteInfo = await PacienteClient.GetByIdAsync(pacienteId!.Value);
        }
        catch (Exception ex) { errores.Add($"obra social ({ex.Message})"); }

        // Historia clínica
        historiaSinPermiso = false;
        try
        {
            historia = await ReportesClient.GetHistoriaClinicaAsync(pacienteId!.Value);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            historiaSinPermiso = true;
        }
        catch (Exception ex) { errores.Add($"historia clínica ({ex.Message})"); }

        // Multas
        try
        {
            misMultas = await MultaClient.GetAllAsync(pacienteId);
        }
        catch (Exception ex) { errores.Add($"multas ({ex.Message})"); }

        if (errores.Count > 0)
            errorMessage = "No se pudo cargar: " + string.Join("; ", errores);

        isLoading = false;
    }

    private void VerTicket()
    {
        turnoTicket = proximoTurno;
        showTicketModal = true;
    }

    private async Task HandleTurnoReservado(TurnoOdontologicoDTO creado)
    {
        showReservaModal = false;
        turnoTicket = creado;
        showTicketModal = true;
        await CargarDatos();
    }

    private void SolicitarCancelarTurno()
    {
        if (seleccionado == null) return;

        if (seleccionado.EstadoTurno is "Cancelado" or "Atendido" or "NoAsistido")
        {
            errorMessage = $"No se puede cancelar un turno en estado {seleccionado.EstadoTurno}.";
            return;
        }

        errorMessage = null;
        mensajeConfirmacion = $"¿Desea cancelar el turno para el {seleccionado.Fecha:dd/MM/yyyy} a las {seleccionado.HorarioTurno}?";
        showConfirmModal = true;
    }

    private async Task HandleConfirmacionCancelar(bool confirmado)
    {
        showConfirmModal = false;

        if (!confirmado || seleccionado == null) return;

        try
        {
            await TurnoClient.CancelarAsync(seleccionado.Id, "Cancelado por el paciente desde el portal");
            seleccionado = null;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cancelar el turno: {ex.Message}";
        }
    }

    private void SolicitarPago(MultaDTO multa)
    {
        multaAPagar = multa;
        mensajePago = $"¿Desea abonar la multa de {multa.Monto:C2} para rehabilitar su cuenta?";
        showConfirmPago = true;
    }

    private async Task HandleConfirmacionPago(bool confirmado)
    {
        showConfirmPago = false;

        if (!confirmado || multaAPagar == null) return;

        try
        {
            await MultaClient.PagarAsync(multaAPagar.Id);
            multaAPagar = null;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo procesar el pago: {ex.Message}";
        }
    }
}
