@page "/pacientes"
@attribute [Authorize(Roles = Permisos.Pacientes)]
@inject PacienteApiClient ApiClient

<PageTitle>Gestión de Pacientes - Turno Molar</PageTitle>

<div class="container-fluid p-0">

    <PageHeader Titulo="Gestión de Pacientes y Fichas Médicas" Subtitulo="Padrón general, control de habilitaciones, obras sociales y antecedentes clínicos" Icono="bi-people" />

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Total Pacientes" Detalle="Registrados en clínica" Color="primary" Icono="bi-people">@pacientes.Count</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Habilitados" Detalle="Aptos para turnos" Color="success" Icono="bi-person-check">@pacientes.Count(p => p.EstadoHabilitado)</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Inhabilitados" Detalle="Con multas o deudas" Color="danger" Icono="bi-person-x">@pacientes.Count(p => !p.EstadoHabilitado)</StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <StatCard Titulo="Con Obra Social" Detalle="Prepagas y mutuales" Color="info" Icono="bi-shield-check">@pacientes.Count(p => p.ObraSocialId.HasValue && p.ObraSocialId.Value != 4)</StatCard>
        </div>
    </div>

    <div class="bg-white p-3 border-top border-bottom">
        <div class="row g-2 align-items-center">
            <div class="col-lg-5 col-xxl-3">
                <div class="input-group">
                    <span class="input-group-text bg-light fw-bold text-secondary">Buscar:</span>
                    <input type="text" class="form-control" placeholder="Nombre, Apellido, DNI o Email..."
                           @bind="textoBuscar" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                </div>
            </div>
            <div class="col-lg-3 col-xxl-2 d-flex align-items-center">
                <div class="form-check ms-2">
                    <input class="form-check-input" type="checkbox" id="chkSoloHabilitados"
                           @bind="soloHabilitados" @bind:after="CargarPacientes" />
                    <label class="form-check-label fw-semibold text-secondary" for="chkSoloHabilitados">
                        Solo Habilitados
                    </label>
                </div>
            </div>
            <div class="col-12 col-xxl-7 d-flex justify-content-end gap-2 flex-wrap">
                <button class="btn btn-theme-primary" @onclick="CargarPacientes" disabled="@isLoading"><i class="bi bi-search"></i> Buscar</button>
                <button class="btn btn-theme-success" @onclick="AbrirModalNuevo">+ Nuevo Paciente</button>
                <button class="btn btn-theme-secondary" @onclick="ModificarSeleccionado" disabled="@(seleccionado == null)"><i class="bi bi-pencil-square"></i> Modificar</button>
                <button class="btn btn-warning fw-bold text-dark" @onclick="SolicitarToggleHabilitacion" disabled="@(seleccionado == null)"><i class="bi bi-lock"></i> Cambiar Estado</button>
                <button class="btn btn-theme-danger" @onclick="SolicitarEliminar" disabled="@(seleccionado == null)"><i class="bi bi-trash"></i> Eliminar</button>
            </div>
        </div>
    </div>

    <div>
        <div class="table-responsive panel">
            <table class="table table-hover align-middle mb-0 table-theme">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>DNI / Doc.</th>
                        <th>Apellido</th>
                        <th>Nombre</th>
                        <th>Usuario Portal</th>
                        <th>Teléfono</th>
                        <th>Correo Electrónico</th>
                        <th>Obra Social / Cobertura</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <div class="small text-muted mt-2">Cargando pacientes desde la base de datos...</div>
                            </td>
                        </tr>
                    }
                    else if (pacientes.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron pacientes registrados con los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in pacientes)
                        {
                            <tr class="@(seleccionado?.Id == p.Id ? "selected-row" : "")"
                                @onclick="() => seleccionado = p"
                                @ondblclick="() => AbrirModalEditar(p)"
                                style="cursor: pointer;">
                                <td><strong>#@p.Id</strong></td>
                                <td>@p.Dni</td>
                                <td>@p.Apellido</td>
                                <td>@p.Nombre</td>
                                <td><span class="badge bg-light text-dark border">@(p.Username ?? "N/A")</span></td>
                                <td>@p.Telefono</td>
                                <td>@p.Mail</td>
                                <td>@(p.ObraSocialNombre ?? "Particular")</td>
                                <td>
                                    @if (p.EstadoHabilitado)
                                    {
                                        <span class="badge bg-success-subtle text-success fw-bold border border-success"><i class="bi bi-check-circle"></i> Habilitado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold border border-danger"><i class="bi bi-x-circle"></i> Inhabilitado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-white p-2 mt-2 border rounded text-muted small">
            @lblEstado
        </div>
    </div>
</div>

<!-- SUBCOMPONENTE MODAL -->
<PacienteDetalleModal Show="showModal"
                      Model="modalModel"
                      IsEditing="isEditing"
                      OnClosed="() => showModal = false"
                      OnSaved="HandlePacienteGuardado" />

<!-- MODAL DE CONFIRMACIÓN -->
<ConfirmModal Show="showConfirmModal"
              Titulo="@confirmTitle"
              Mensaje="@confirmMessage"
              OnResponse="HandleConfirmacion" />

<!-- MODAL CONFIRMACIÓN CREDENCIALES -->
@if (showCredsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">Alta de Paciente Exitosa</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showCredsModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="fw-bold mb-3 text-dark">¡Paciente registrado con éxito!</p>
                    <div class="p-3 bg-light rounded border">
                        <p class="fw-bold text-primary mb-2"><i class="bi bi-key"></i> Credenciales para el Portal del Paciente:</p>
                        <p class="mb-1"><strong>• Usuario:</strong> <code>@createdUsername</code></p>
                        <p class="mb-0"><strong>• Contraseña:</strong> <code>@createdPassword</code></p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success fw-bold px-4" @onclick="() => showCredsModal = false">Entendido</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PacienteDTO> pacientes = new();
    private PacienteDTO? seleccionado;
    private string textoBuscar = "";
    private bool soloHabilitados = false;
    private string lblEstado = "Cargando pacientes...";
    private bool isLoading = false;

    private bool showModal = false;
    private bool isEditing = false;
    private PacienteDTO modalModel = new();

    private bool showConfirmModal = false;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private TipoAccionConfirmar accionPendiente;

    private enum TipoAccionConfirmar
    {
        ToggleEstado,
        Eliminar
    }

    private bool showCredsModal = false;
    private string createdUsername = "";
    private string createdPassword = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        isLoading = true;
        lblEstado = "Buscando pacientes en la base de datos...";
        try
        {
            bool? habilitadosFilter = soloHabilitados ? true : null;
            pacientes = await ApiClient.GetByCriteriaAsync(textoBuscar.Trim(), habilitadosFilter);
            lblEstado = $"Padrón activo: {pacientes.Count} paciente(s) registrado(s). Habilitados: {pacientes.Count(p => p.EstadoHabilitado)}.";
            if (seleccionado != null)
            {
                seleccionado = pacientes.FirstOrDefault(p => p.Id == seleccionado.Id);
            }
        }
        catch (Exception ex)
        {
            lblEstado = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CargarPacientes();
    }

    private void AbrirModalNuevo()
    {
        modalModel = new PacienteDTO { EstadoHabilitado = true };
        isEditing = false;
        showModal = true;
    }

    private void AbrirModalEditar(PacienteDTO p)
    {
        modalModel = new PacienteDTO
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Apellido = p.Apellido,
            Dni = p.Dni,
            Telefono = p.Telefono,
            Mail = p.Mail,
            Domicilio = p.Domicilio,
            EstadoHabilitado = p.EstadoHabilitado,
            ObraSocialId = p.ObraSocialId,
            NumeroAfiliado = p.NumeroAfiliado,
            Username = p.Username
        };
        isEditing = true;
        showModal = true;
    }

    private void ModificarSeleccionado()
    {
        if (seleccionado != null) AbrirModalEditar(seleccionado);
    }

    private async Task HandlePacienteGuardado(PacienteDTO guardado)
    {
        showModal = false;
        if (!isEditing)
        {
            createdUsername = guardado.Username ?? (string.IsNullOrWhiteSpace(guardado.Mail) ? $"{guardado.Nombre.ToLower()}{guardado.Dni}" : guardado.Mail.Split('@')[0]);
            createdPassword = guardado.PasswordDefault ?? "paciente123";
            showCredsModal = true;
        }
        await CargarPacientes();
    }

    private void SolicitarToggleHabilitacion()
    {
        if (seleccionado == null) return;
        bool nuevoEstado = !seleccionado.EstadoHabilitado;
        string accion = nuevoEstado ? "HABILITAR" : "INHABILITAR (Bloqueo de turnos)";

        confirmTitle = "Control de Estado";
        confirmMessage = $"¿Desea {accion} al paciente {seleccionado.Apellido}, {seleccionado.Nombre}?";
        accionPendiente = TipoAccionConfirmar.ToggleEstado;
        showConfirmModal = true;
    }

    private void SolicitarEliminar()
    {
        if (seleccionado == null) return;

        confirmTitle = "Confirmar Eliminación";
        confirmMessage = $"¿Está seguro de eliminar la ficha médica del paciente {seleccionado.Apellido}, {seleccionado.Nombre}?\nEsta acción no se puede deshacer.";
        accionPendiente = TipoAccionConfirmar.Eliminar;
        showConfirmModal = true;
    }

    private async Task HandleConfirmacion(bool confirmado)
    {
        showConfirmModal = false;

        if (!confirmado || seleccionado == null) return;

        try
        {
            if (accionPendiente == TipoAccionConfirmar.ToggleEstado)
            {
                var cambio = !seleccionado.EstadoHabilitado;
                seleccionado.EstadoHabilitado = cambio;
                try
                {
                    await ApiClient.UpdateAsync(seleccionado);
                }
                catch
                {
                    seleccionado.EstadoHabilitado = !cambio;
                    throw;
                }
                await CargarPacientes();
            }
            else if (accionPendiente == TipoAccionConfirmar.Eliminar)
            {
                await ApiClient.DeleteAsync(seleccionado.Id);
                seleccionado = null;
                await CargarPacientes();
                lblEstado = "Paciente eliminado.";
            }
        }
        catch (HttpRequestException ex)
        {
            // Por ejemplo: el paciente tiene turnos o historia clínica y no se puede eliminar.
            lblEstado = ex.Message;
        }
    }
}
