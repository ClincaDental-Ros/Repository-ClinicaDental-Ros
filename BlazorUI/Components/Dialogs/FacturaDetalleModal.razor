@inject FacturaApiClient ApiClient

@if (Show && Factura != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0">

                <!-- HEADER -->
                <div class="modal-header btn-theme-primary text-white p-3">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">🧾 Liquidación Fiscal N° @((1000 + Factura.Id).ToString("D6"))</h5>
                        <small class="text-white-50">Fecha de Emisión: @Factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3 pb-3 border-bottom small">
                        <div class="col-md-6">
                            <strong>👤 Paciente:</strong> @Factura.PacienteNombre
                        </div>
                        <div class="col-md-6">
                            <strong>🛡️ Obra Social / Prepaga:</strong> @Factura.ObraSocialNombre
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2" style="color: var(--color-primary);">Detalle de Honorarios e Insumos Consumidos:</h6>

                    <div class="table-responsive rounded border mb-3">
                        <table class="table table-sm table-hover align-middle mb-0 table-theme">
                            <thead>
                                <tr>
                                    <th>Insumo / Concepto Prestacional</th>
                                    <th style="width: 80px;">Cant.</th>
                                    <th style="width: 120px;">P. Unitario</th>
                                    <th style="width: 120px;">Subtotal ($)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Factura.Items == null || Factura.Items.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-2 text-muted">Sin ítems adicionales.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Factura.Items)
                                    {
                                        <tr>
                                            <td>@item.InsumoNombre</td>
                                            <td>@item.CantidadInsumo</td>
                                            <td>@item.PrecioUnitario.ToString("C2")</td>
                                            <td><strong>@item.Subtotal.ToString("C2")</strong></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- TOTALES -->
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Subtotal Honorarios + Insumos:</span>
                            <span>@Factura.Subtotal.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between text-success fw-bold small mb-2">
                            <span>Descuento Cobertura Obra Social:</span>
                            <span>-@Factura.DescuentoObraSocial.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between fs-5 fw-bold" style="color: var(--color-primary);">
                            <span>TOTAL A COBRAR PACIENTE:</span>
                            <span>@Factura.MontoAPagarPaciente.ToString("C2")</span>
                        </div>
                    </div>

                    <!-- METODO DE PAGO -->
                    @if (!Factura.EstadoPago)
                    {
                        <div class="mt-3">
                            <label class="form-label fw-bold">Medio de Pago:</label>
                            <select class="form-select" @bind="metodoPago">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta de Débito">Tarjeta de Débito</option>
                                <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                                <option value="Transferencia Bancaria / QR">Transferencia Bancaria / QR</option>
                            </select>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small mt-3" role="alert">
                            @errorMessage
                        </div>
                    }
                </div>

                <!-- FOOTER -->
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-theme-secondary" @onclick="Cerrar" disabled="@isSaving">Cerrar</button>

                    @if (!Factura.EstadoPago)
                    {
                        <button type="button" class="btn btn-theme-success" @onclick="RegistrarCobro" disabled="@isSaving">
                            @(isSaving ? "Procesando..." : "💳 Registrar Cobro en Caja")
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success fs-6 border border-success px-3 py-2">
                            ✅ Factura Pagada (@Factura.MetodoPago)
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public FacturaDTO? Factura { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnPaid { get; set; }

    private string metodoPago = "Efectivo";
    private bool isSaving = false;
    private string errorMessage = "";

    private async Task Cerrar()
    {
        await OnClosed.InvokeAsync();
    }

    private async Task RegistrarCobro()
    {
        if (Factura == null) return;

        isSaving = true;
        errorMessage = "";

        try
        {
            await ApiClient.PagarAsync(Factura.Id, metodoPago);
            await OnPaid.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}