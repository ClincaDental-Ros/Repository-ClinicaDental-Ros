@inherits LayoutComponentBase
@implements IDisposable
@inject BlazorAuthService AuthService
@inject NavigationManager Navigation

<div class="d-flex flex-column vh-100" style="background-color: var(--color-background); color: var(--color-text-primary);">

    @if (AuthService.IsAuthenticated())
    {
        <!-- Menú Superior de Navegación -->
        <header class="shadow-sm" style="background-color: var(--color-card-bg); border-bottom: 1px solid var(--color-border);">
            <NavMenu />
        </header>
    }

    <!-- Contenido Principal de las Páginas -->
    <main class="flex-grow-1 p-3 overflow-auto">
        @Body
    </main>

    @if (AuthService.IsAuthenticated())
    {
        <!-- Barra de Estado Inferior (StatusStrip) -->
        <footer class="d-flex justify-content-between align-items-center px-3 py-1.5"
                style="background-color: var(--color-primary-dark); border-top: 1px solid var(--color-primary); color: #ffffff; font-size: 0.825rem;">
            <div class="d-flex align-items-center gap-2">
                <span>👤 Sesión: <strong>@NombreUsuario</strong></span>
                <span class="badge" style="background-color: var(--color-accent); color: #ffffff;">@RolUsuario.ToUpper()</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <span style="color: var(--color-success-light);">🟢 Conectado a API (localhost:5263)</span>
            </div>
        </footer>
    }
</div>

@code {
    private string NombreUsuario => AuthService.GetNombreCompleto() ?? AuthService.GetUsername() ?? "Usuario";
    private string RolUsuario => AuthService.GetRol() ?? "Admin";

    protected override void OnInitialized()
    {
        BaseApiClient.OnUnauthorized -= HandleUnauthorized;
        BaseApiClient.OnUnauthorized += HandleUnauthorized;

        AuthService.OnAuthenticationStateChanged += HandleAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();

            if (!AuthService.IsAuthenticated() && !Navigation.Uri.Contains("/login"))
            {
                Navigation.NavigateTo("/login");
            }

            StateHasChanged();
        }
    }

    private void HandleAuthStateChanged(bool isAuth)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleUnauthorized()
    {
        _ = InvokeAsync(async () =>
        {
            await AuthService.ClearSessionAsync();
            Navigation.NavigateTo("/login");
        });
    }

    public void Dispose()
    {
        BaseApiClient.OnUnauthorized -= HandleUnauthorized;
        AuthService.OnAuthenticationStateChanged -= HandleAuthStateChanged;
    }
}